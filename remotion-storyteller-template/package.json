{
  "name": "remotion-storyteller-video",
  "version": "1.0.0",
  "private": true,
  "description": "Proyek motion graphic storytelling 2D & 3D berbasis Remotion",
  "scripts": {
    "dev": "remotion studio",
    "sync": "python3 scripts/sync_timeline.py --manifest manifest.json --transcript transcript.json",
    "sync:noaudio": "python3 scripts/sync_timeline.py --manifest manifest.json",
    "check": "bash scripts/make_contact_sheet.sh MainStory",
    "render:full": "remotion render src/index.ts MainStory out/main-story.mp4 --gl=angle",
    "render:vertical": "remotion render src/index.ts ShortVertical out/short-vertical.mp4 --gl=angle",
    "render:short": "remotion render src/index.ts HighlightVertical out/highlight-vertical.mp4 --gl=angle",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.250",
    "@remotion/three": "4.0.250",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.250",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
